// Prisma Schema for GITHUBRECON

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A tenant. All domains, scans and findings belong to exactly one organization,
/// and members only ever see their own organization's data. The super admin
/// belongs to no organization and sees everything.
/// The quota/feature fields act as a ceiling: a member's effective capability is
/// their own permission AND what the organization allows.
model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  active      Boolean  @default(true)   // false suspends every member
  maxDomains  Int      @default(10)
  maxUsers    Int      @default(25)
  canRunScans Boolean  @default(true)
  canExport   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users   User[]
  domains Domain[]

  @@index([slug])
  @@index([active])
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  username String  @unique
  /// bcrypt hash — never store or log the plaintext password
  passwordHash String
  githubId String? @unique
  apiKey   String? // Encrypted GitHub token

  /// SUPER_ADMIN | ORG_ADMIN | ANALYST | VIEWER — see utils/permissions.ts
  role String @default("ANALYST")
  /// JSON overrides on top of the role defaults: {"granted":[...],"revoked":[...]}
  permissions String?

  /// null only for SUPER_ADMIN, who is not scoped to a tenant
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  /// False only for a freshly-seeded super admin awaiting first-run setup: the
  /// stored hash is an unusable placeholder and login is refused until the
  /// one-time setup screen sets a real password.
  passwordSet Boolean @default(true)
  lastLoginAt DateTime?
  /// Brute-force protection: cleared on any successful login
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains       Domain[]
  scans         Scan[]
  sessions      Session[]
  querySettings QuerySetting[]

  @@index([email])
  @@index([username])
  @@index([orgId])
  @@index([active])
}

/// One row per issued refresh token. Only the SHA-256 of the token is stored, so
/// a database leak cannot be replayed. Rotated on every refresh.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only trail of security-relevant actions (logins, user/org changes).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Domain {
  id            String    @id @default(uuid())
  name          String
  /// Owning tenant — this is what scopes visibility
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Who added it (kept for attribution; does NOT restrict visibility)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active        Boolean   @default(true)
  scanFrequency String    @default("manual") // manual, hourly, daily, weekly
  lastScanAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  scans         Scan[]

  // Each organization can have one domain with a given name
  @@unique([orgId, name])
  @@index([orgId])
  @@index([userId])
  @@index([active, lastScanAt])
  @@index([name])
}

model Scan {
  id            String     @id @default(uuid())
  domainId      String
  domain        Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String     @default("QUEUED")
  startedAt     DateTime?
  completedAt   DateTime?
  totalFindings Int        @default(0)
  criticalCount Int        @default(0)
  highCount     Int        @default(0)
  mediumCount   Int        @default(0)
  lowCount      Int        @default(0)
  infoCount     Int        @default(0)
  errorMessage  String?
  createdAt     DateTime   @default(now())
  findings      Finding[]

  @@index([domainId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Finding {
  id             String       @id @default(uuid())
  scanId         String
  scan           Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository     String
  repositoryUrl  String
  filePath       String
  fileUrl        String?
  commitSha      String?
  commitUrl      String?
  commitDate     DateTime?
  gistId         String?
  issueNumber    Int?
  score          Float        @default(0) // Criticality score 0-100 (File-level aggregate)
  primaryType    String       // Type of highest-scoring secret, e.g., "AWS_SECRET_KEY"
  criticality    String       // e.g., "CRITICAL", "HIGH" based on file score
  verified       Boolean      @default(false)
  falsePositive  Boolean      @default(false)
  acknowledged   Boolean      @default(false)
  notes          String?
  secrets        Secret[]     // One file can have many secrets
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([scanId])
  @@index([primaryType])
  @@index([criticality])
  @@index([repository])
  @@index([verified, falsePositive])
}

model Secret {
  id             String       @id @default(uuid())
  findingId      String
  finding        Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type           String       // E.g., "AWS_ACCESS_KEY", "EMAIL"
  criticality    String       // E.g., "CRITICAL", "INFO"
  content        String
  contentPreview String
  context        String
  lineNumber     Int?
  createdAt      DateTime     @default(now())

  @@index([findingId])
  @@index([type])
  @@index([content])
}

/// Per-user opt-out list for catalog queries (see src/utils/queryCatalog.ts).
/// Storage is sparse: a missing row means the query is ENABLED, so newly added
/// catalog queries are live by default and only explicit toggles are persisted.
/// Cascades from User so deleting an account cannot leave orphaned preferences.
model QuerySetting {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  queryId   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, queryId])
  @@index([userId])
}

// SQLite doesn't support enums, so we use strings with comments for valid values

// Role: "USER" | "ADMIN"
// ScanStatus: "QUEUED" | "RUNNING" | "COMPLETED" | "FAILED" | "CANCELLED"
// FindingType: "DOMAIN" | "EMAIL" | "API_KEY" | "AWS_ACCESS_KEY" | "AWS_SECRET_KEY" | "GITHUB_TOKEN" | "GITLAB_TOKEN" | "BITBUCKET_TOKEN" | "PRIVATE_KEY" | "SSH_KEY" | "PGP_KEY" | "PASSWORD" | "DATABASE_URL" | "CONNECTION_STRING" | "SLACK_TOKEN" | "SLACK_WEBHOOK" | "STRIPE_KEY" | "SQUARE_KEY" | "PAYPAL_TOKEN" | "JWT_SECRET" | "OAUTH_TOKEN" | "BEARER_TOKEN" | "GOOGLE_API_KEY" | "FIREBASE_KEY" | "AZURE_KEY" | "HEROKU_KEY" | "CLOUDFLARE_KEY" | "SENDGRID_KEY" | "TWILIO_KEY" | "MAILCHIMP_KEY" | "DATADOG_KEY" | "SHOPIFY_KEY" | "NPM_TOKEN" | "NPMRC_AUTH" | "DOCKER_PASSWORD" | "GENERIC_SECRET"
// Criticality: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO"
