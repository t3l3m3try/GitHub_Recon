{
  "name": "github-recon",
  "version": "1.0.0",
  "description": "Multi-tenant platform for detecting sensitive information exposed in public GitHub repositories",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "github",
    "security",
    "secrets-detection",
    "threat-intelligence"
  ],
  "author": "t3l3m3try",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}