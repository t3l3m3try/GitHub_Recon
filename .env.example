# ─── Required ────────────────────────────────────────────────────────────────

# GitHub Personal Access Token — scopes: public_repo, read:user
GITHUB_TOKEN=your_github_token_here


# ─── Security ────────────────────────────────────────────────────────────────

# Signing key for access tokens. REQUIRED in production, minimum 32 characters.
# In development one is generated and written to backend/.env automatically.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Encrypts 2FA (TOTP) secrets at rest. REQUIRED in production, minimum 32
# characters. In development one is generated and written to backend/.env
# automatically, the same way JWT_SECRET is. Deliberately a separate key so
# rotating one never invalidates the other.
# TWO_FACTOR_ENCRYPTION_KEY=

# Set to "production" to enable Secure cookies and require JWT_SECRET
# NODE_ENV=development

# Allowed browser origin. Credentialed CORS cannot use a wildcard.
# FRONTEND_URL=http://localhost:5173

# Failed sign-ins allowed per IP per window (successful ones are not counted)
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MS=900000


# ─── First-run seeding ───────────────────────────────────────────────────────

# The seed creates one super administrator. If SUPER_ADMIN_PASSWORD is left
# unset, the account has no password at all and the app walks whoever opens
# it first through a one-time setup screen to choose one — nothing is
# generated or printed. Set it here only for non-interactive installs.
# SUPER_ADMIN_EMAIL=superadmin@localhost.local
# SUPER_ADMIN_USERNAME=superadmin
# SUPER_ADMIN_PASSWORD=

# Optional organizations to create on first run, comma-separated
# SEED_ORGANIZATIONS=Acme Corp,Globex

# Organization that adopts domains left without one (upgrades from older installs)
# DEFAULT_ORGANIZATION=Default Organization


# ─── Server ──────────────────────────────────────────────────────────────────

# PORT=3001
# DATABASE_URL=file:./dev.db

# Winston log level: error | warn | info | debug
# LOG_LEVEL=info
